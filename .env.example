# SEC EDGAR requires a descriptive User-Agent ("YourName your@email.com")
# on every request, or it returns HTTP 403. Replace with your own identity.
SEC_USER_AGENT=YourName your@email.com

# Ollama models — both CPU-only (see TRIPWIRE_PROJECT_BRIEF.md section 4).
OLLAMA_MODEL_SMALL=qwen2.5:3b
OLLAMA_MODEL_LARGE=qwen2.5:7b

# Service endpoints, as reachable from inside the compose network.
OLLAMA_HOST=http://ollama:11434
QDRANT_HOST=qdrant
QDRANT_PORT=6333
